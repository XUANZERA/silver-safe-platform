APP_NAME=银发独游协同平台
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Replace this value outside local development.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=silver-safe-platform
JWT_AUDIENCE=silver-safe-api
HEALTH_INFO_ENCRYPTION_KEY=replace-with-a-separate-random-key-at-least-32-characters

# Relative SQLite paths are resolved from the repository root.
DATABASE_URL=sqlite:///./data/silver_safe.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_PROXY_NETWORKS=[]

LOGIN_FAILURE_WINDOW_SECONDS=300
LOGIN_FAILURE_PER_USERNAME=5
LOGIN_FAILURE_PER_IP=20
AUDIT_RETENTION_DAYS=180
