page {
  min-height: 100%;
  background: #f4f7fb;
  color: #1f2937;
  font-size: 30rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(31, 41, 55, 0.06);
}

.title {
  margin-bottom: 12rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle,
.muted {
  color: #667085;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #475467;
  font-size: 26rpx;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 16rpx;
  background: #fff;
}

.button-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.button-row button {
  flex: 1;
  margin: 0;
}

.primary-button {
  background: #1677ff;
  color: #fff;
}

.secondary-button {
  border: 1rpx solid #b9c3d0;
  background: #fff;
  color: #344054;
}

.error {
  margin-top: 20rpx;
  color: #d92d20;
  line-height: 1.5;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
}

.row-label {
  flex: none;
  color: #667085;
}

.row-value {
  text-align: right;
  word-break: break-all;
}

.link {
  display: inline-block;
  margin-top: 16rpx;
  color: #1677ff;
}

.feedback-card {
  margin-top: 32rpx;
}

.feedback-button {
  margin-top: 24rpx;
}
