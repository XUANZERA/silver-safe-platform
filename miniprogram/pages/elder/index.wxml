<view class="page">
  <view class="card">
    <view class="title">老人定位守护</view>
    <view class="subtitle">定位只会在您点击开启后运行，离开或刷新页面即停止。</view>
    <navigator class="link" url="/pages/family/map">切换到家属端</navigator>
  </view>

  <view class="card" wx:if="{{!loggedIn}}">
    <view class="section-title">账号登录</view>
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="input" value="{{username}}" bindinput="onUsernameInput" placeholder="老人账号" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" value="{{password}}" password bindinput="onPasswordInput" placeholder="密码" />
    </view>
    <button class="primary-button" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="handleLogin">登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
    <view class="card">
      <view class="section-title">当前账号</view>
      <view class="row">
        <text class="row-label">用户名</text>
        <text class="row-value">{{user.username}}</text>
      </view>
      <view class="button-row">
        <button class="secondary-button" loading="{{loadingTrip}}" bindtap="loadCurrentTrip">刷新行程</button>
        <button class="secondary-button" bindtap="handleLogout">退出</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">今日任务</view>
      <block wx:if="{{currentTrip}}">
        <view class="row">
          <text class="row-label">目的地</text>
          <text class="row-value">{{currentTrip.destination}}</text>
        </view>
        <view class="row">
          <text class="row-label">任务状态</text>
          <text class="row-value">{{tripStatusText}}</text>
        </view>
      </block>
      <view class="muted" wx:else>今天暂时没有出行任务。</view>
    </view>

    <view class="card">
      <view class="section-title">定位状态</view>
      <view class="status status-{{locationStatus}}">{{locationStatusText}}</view>
      <view class="button-row">
        <button wx:if="{{!guardRunning}}" class="primary-button" disabled="{{!hasActiveTrip}}" bindtap="handleStartGuard">开启定位守护</button>
        <button wx:else class="secondary-button" bindtap="handleStopGuard">停止定位守护</button>
        <button wx:if="{{locationStatus === 'PERMISSION_DENIED'}}" class="secondary-button" bindtap="handleOpenSetting">打开设置</button>
      </view>
    </view>
  </block>

  <view class="card feedback-card">
    <view class="section-title">体验反馈</view>
    <view class="muted">如遇到使用困难、功能异常，或有改进建议，请告诉我们。</view>
    <button class="secondary-button feedback-button" open-type="feedback">提交反馈</button>
  </view>

  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>
</view>
