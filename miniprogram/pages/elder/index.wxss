.status {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #eef2f6;
  font-weight: 600;
}

.status-REQUESTING {
  background: #fff7e6;
  color: #b54708;
}

.status-TRACKING {
  background: #ecfdf3;
  color: #027a48;
}

.status-DEGRADED,
.status-PERMISSION_DENIED {
  background: #fef3f2;
  color: #b42318;
}

.sos-card {
  border-color: #fecdca;
}

.sos-help {
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.sos-button {
  background: #c62828;
  color: #fff;
  font-weight: 700;
}

.sos-error {
  margin-top: 16rpx;
}
