APP_NAME=银发独游协同平台（志愿者测试）
APP_VERSION=0.1.0
APP_ENV=testing
DEBUG=false
API_PREFIX=/api/v1

# 部署时必须替换以下三个值，不要把真实值提交到仓库。
SECRET_KEY=replace-with-a-random-testing-secret-at-least-32-characters
HEALTH_INFO_ENCRYPTION_KEY=replace-with-a-separate-testing-key-at-least-32-characters
TEST_ACCOUNT_PASSWORD=replace-with-a-private-volunteer-password

# 测试数据库必须与开发、未来生产环境分离。
DATABASE_URL=sqlite:///./data/volunteer_test.db
CORS_ORIGINS=[]
TRUSTED_PROXY_NETWORKS=[]

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
LOCATION_STALE_AFTER_SECONDS=60
AUDIT_RETENTION_DAYS=180
